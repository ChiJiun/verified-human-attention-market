# API
API_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vham
# Bearer token (>= 16 chars) required by GET /metrics. Unset = open endpoint;
# then keep /metrics off the public internet.
METRICS_TOKEN=
# Blocks a chain event (and a campaign creation, before the API links it)
# must be buried under before it is treated as final.
INDEXER_CONFIRMATIONS=10
# Max blocks per eth_getLogs request. The public Base Sepolia RPC rejects more
# than 200 (HTTP 413); a dedicated provider may allow the code default of 2000.
INDEXER_MAX_BLOCK_RANGE=200
# Indexer worker poll interval between passes (ms).
INDEXER_POLL_MS=5000
# Indexer worker Prometheus port (unset = no metrics server).
INDEXER_METRICS_PORT=9464
# Retention enforcement in the indexer worker (#22); 0 = disabled (then run
# `pnpm --filter @vham/api retention` from cron).
RETENTION_INTERVAL_MS=3600000
# Settlement reconciliation in the indexer worker (#29); 0 = disabled.
RECONCILIATION_INTERVAL_MS=600000

# Chain (validated at API startup; partial config fails fast).
# Base Sepolia = 84532, local anvil = 31337. Base mainnet is not enabled.
EVM_CHAIN_ID=84532
EVM_RPC_URL=
# Base Sepolia official Circle test USDC (checked 2026-10-12):
# 0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=
CAMPAIGN_MANAGER_ADDRESS=
CAMPAIGN_MANAGER_DEPLOY_BLOCK=

# Web app (apps/web): the API that /api/* is proxied to, and the chain the
# wallet must be on.
API_URL=http://localhost:3001
NEXT_PUBLIC_CHAIN_ID=84532

# Local deployment script (packages/contracts/script/DeployLocal.s.sol):
# advertiser that receives mock USDC on anvil.
ADVERTISER_ADDRESS=

# Deployment script (packages/contracts/script/DeployCampaignManager.s.sol)
EXPECTED_CHAIN_ID=84532
CLAIM_SIGNER_ADDRESS=
MAX_REWARD_PER_COMPLETION=1000000
MAX_COMPLETIONS_PER_CAMPAIGN=10
MAX_CAMPAIGN_BUDGET=10000000

# World ID (ADR-0007). Live needs WORLD_ID_APP_ID, WORLD_ID_RP_ID and
# RP_SIGNING_KEY together: none set disables World ID (eligibility fails
# closed), a partial or malformed set stops the API at startup.
WORLD_ID_APP_ID=
WORLD_ID_RP_ID=
# production | staging (staging only with the World ID simulator)
WORLD_ID_ENVIRONMENT=production
# live (default) | simulated. "simulated" is a local demo stand-in and the API
# refuses to start with it on any chain other than anvil (31337).
WORLD_ID_MODE=live
# Server-only RP signing key for IDKit requests (from the Developer Portal).
# Never commit it and never expose it to the browser.
RP_SIGNING_KEY=

# Sign-In with Ethereum (#37): RFC 3986 authority of the web app, e.g.
# app.example.com. Unset = sign-in disabled; advertiser endpoints return 401.
SIWE_DOMAIN=

# Moderation (#24). review (default) | open. "open" is refused off anvil.
MODERATION_MODE=review
# Comma-separated operator wallets (SIWE) allowed to use /v1/admin.
OPERATOR_ADDRESSES=
# Comma-separated advertisers whose campaigns start approved (early beta).
ADVERTISER_ALLOWLIST=
# Optional comma-separated content domains (subdomains included); unset = any
# public https domain.
CONTENT_DOMAIN_ALLOWLIST=

# Public API (#26): per-instance rate limits and trusted proxy hops.
RATE_LIMIT_ANONYMOUS_PER_MINUTE=300
RATE_LIMIT_SENSITIVE_PER_MINUTE=30
RATE_LIMIT_CLIENT_DEFAULT_PER_MINUTE=600
RATE_LIMIT_CLIENT_MAX_PER_MINUTE=6000
TRUST_PROXY_HOPS=0

# HMAC secret (>= 32 chars) for campaign-scoped participant keys. Rotating it
# breaks duplicate-human detection for existing campaigns.
PARTICIPANT_KEY_SECRET=

# Claim signer (ADR-0008). Production: KMS key behind a signing service that
# speaks eth_signTypedData (e.g. Web3Signer); CLAIM_SIGNER_ADDRESS is its key.
CLAIM_SIGNER_URL=
CLAIM_SIGNER_AUTHORIZATION=
# Local/testnet only (refused off chains 31337 and 84532). NEVER commit real keys.
CLAIM_SIGNER_PRIVATE_KEY=
# Global 24 h claim-liability limit in atomic units (default 100 test USDC).
DAILY_PAYOUT_LIMIT_ATOMIC=100000000
