# API
API_PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vham

# Chain (validated at API startup; partial config fails fast).
# Base Sepolia = 84532, local anvil = 31337. Base mainnet is not enabled.
EVM_CHAIN_ID=84532
EVM_RPC_URL=
# Base Sepolia official Circle test USDC (checked 2026-10-12):
# 0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=
CAMPAIGN_MANAGER_ADDRESS=
CAMPAIGN_MANAGER_DEPLOY_BLOCK=

# Deployment script (packages/contracts/script/DeployCampaignManager.s.sol)
EXPECTED_CHAIN_ID=84532
CLAIM_SIGNER_ADDRESS=
MAX_REWARD_PER_COMPLETION=1000000
MAX_COMPLETIONS_PER_CAMPAIGN=10
MAX_CAMPAIGN_BUDGET=10000000

# World ID (ADR-0007). Eligibility fails closed when RP id or secret is unset.
WORLD_ID_APP_ID=
WORLD_ID_RP_ID=
# production | staging (staging only with the World ID simulator)
WORLD_ID_ENVIRONMENT=production
# Server-only RP signing key for IDKit requests (used by the user flow, #12).
RP_SIGNING_KEY=

# HMAC secret (>= 32 chars) for campaign-scoped participant keys. Rotating it
# breaks duplicate-human detection for existing campaigns.
PARTICIPANT_KEY_SECRET=

# Claim signer - NEVER use a production key in local examples or commit real keys.
CLAIM_SIGNER_PRIVATE_KEY=
