{
  "name": "@vham/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "indexer": "tsx src/indexer-worker.ts",
    "indexer:start": "node dist/indexer-worker.js",
    "retention": "tsx src/retention-job.ts",
    "retention:start": "node dist/retention-job.js",
    "reconcile": "tsx src/reconcile-job.ts",
    "reconcile:start": "node dist/reconcile-job.js",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  },
  "dependencies": {
    "@vham/shared": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.12.5",
    "postgres": "3.4.9",
    "viem": "2.38.6",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
