{
  "name": "@vham/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contracts": {
      "types": "./dist/contracts/campaign-manager-abi.d.ts",
      "default": "./dist/contracts/campaign-manager-abi.js"
    },
    "./chains": {
      "types": "./dist/chains.d.ts",
      "default": "./dist/chains.js"
    },
    "./deployment": {
      "types": "./dist/deployment.d.ts",
      "default": "./dist/deployment.js"
    },
    "./settlement": {
      "types": "./dist/settlement.d.ts",
      "default": "./dist/settlement.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
